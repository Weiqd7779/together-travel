{
  "name": "together-travel",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:api": "node --watch server/index.mjs",
    "build": "tsc -b && vite build",
    "preview": "node server/index.mjs",
    "start": "node server/index.mjs",
    "test": "vitest run",
    "test:server": "node --test server/*.test.mjs",
    "test:watch": "vitest",
    "check": "npm run test && npm run test:server && npm run build"
  },
  "dependencies": {
    "lucide-react": "^1.25.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/react": "^19.0.3",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^6.0.3",
    "axe-core": "^4.12.1",
    "jsdom": "^29.1.1",
    "typescript": "~7.0.2",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
